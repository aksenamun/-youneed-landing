{
  "rewrites": [
    {
      "source": "/task/:id",
      "destination": "/api/task/:id"
    },
    {
      "source": "/task/:id/",
      "destination": "/api/task/:id"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/delete-account/",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/admin/users/:id",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/users/:id/",
      "destination": "/admin/index.html"
    }
  ]
}
